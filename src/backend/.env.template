# Template for src/backend/.env, which is never committed — it is gitignored with no exception.
#
# Every key below has a default in core/env.js, so the application runs without a .env file at
# all. Copy this file to .env only to override one of them. Keep this template listing every key
# core/env.js reads, with the values left empty.

# Web backend port. Defaults to 9000.
PORT=

# JsonWebToken secret used to sign session cookies. Defaults to 'secret', which is fine for
# development and must be set to something private before the app is reachable from outside:
# with the default, anybody can forge a session cookie. The server warns at startup when the
# default is in use.
JWT_SECRET=
